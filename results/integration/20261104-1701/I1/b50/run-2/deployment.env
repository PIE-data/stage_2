# Single-machine deployment configuration.
# Loaded by Bash: use NAME=value and quote paths containing spaces.
# Paths below refer to the Linux environment.

# Default workspace for the complete pipeline.
# Override this when testing Search against an existing datamart.
DATA_DIR="${HOME}/bench/s2-deployment/data"

# Runtime files: process identities, logs and generated nginx configuration.
RUN_DIR="${HOME}/bench/s2-deployment/run"

# Executables.
JAVA_BIN="java"
NGINX_BIN="nginx"

# Replica counts.
INGESTION_REPLICAS=2
INDEXING_REPLICAS=2
SEARCH_REPLICAS=2

# Replica i uses BASE_PORT + (i - 1) * PORT_STEP.
INGESTION_BASE_PORT=7001
INDEXING_BASE_PORT=7002
SEARCH_BASE_PORT=7003
PORT_STEP=10

FEEDER_PORT=7004
BROKER_PORT=61616
BROKER_HTTP_PORT=7000
GATEWAY_PORT=8080

# HTTP thread pool per service process.
HTTP_THREADS_MIN=8
HTTP_THREADS_MAX=64

# Message consumer sessions per replica.
INGESTION_CONSUMER_THREADS=4
INDEXING_CONSUMER_THREADS=2

# Indexing batch settings per consumer session.
INDEXING_BATCH_SIZE=20
INDEXING_BATCH_WAIT_MS=200

# SQLite writer page cache, MiB.
DATAMART_CACHE_MB=256

# JVM heap limits per process.
JAVA_HEAP_MIN="64m"
JAVA_HEAP_MAX="512m"

# Ingestion source.
SOURCE_BASE_URL="https://www.gutenberg.org"

# Gateway settings.
GATEWAY_BIND="127.0.0.1"
NGINX_WORKERS=1
NGINX_WORKER_CONNECTIONS=1024
PROXY_CONNECT_TIMEOUT_SECONDS=2
PROXY_READ_TIMEOUT_SECONDS=60
UPSTREAM_FAIL_TIMEOUT_SECONDS=5

# Process lifecycle and monitoring.
STARTUP_TIMEOUT_SECONDS=60
STOP_TIMEOUT_SECONDS=30
MONITOR_INTERVAL_SECONDS=1

# --- bench-integration.sh ---
DATA_DIR="/home/andrea/bench/s2-integration/data"
RUN_DIR="/home/andrea/bench/s2-integration/run"
INGESTION_REPLICAS=1
INDEXING_REPLICAS=1
SEARCH_REPLICAS=1
INDEXING_BATCH_SIZE=50
